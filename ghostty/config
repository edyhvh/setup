# Gruvbox Dark Hard — built-in Ghostty theme
theme = "Gruvbox Dark Hard"

# Solid block cursor. Ghostty's shell integration would otherwise
# switch to a bar at the prompt.
cursor-style = block
cursor-style-blink = false
shell-integration-features = no-cursor,ssh-env,ssh-terminfo

# SSH: ssh-terminfo copies xterm-ghostty to the remote ~/.terminfo.
# ssh-env falls back to xterm-256color if that install fails.
# COLORTERM is set locally; most sshd configs do not forward it.
env = COLORTERM=truecolor

# Explicit colors so the theme still applies even if theme lookup fails.
background = #1d2021
foreground = #ebdbb2
cursor-color = #ebdbb2
cursor-text = #1d2021
selection-background = #504945
selection-foreground = #ebdbb2

# Regular ANSI (0–7). Brighter than stock so 16-color apps stay readable.
palette = 0=#3c3836
palette = 1=#ea6962
palette = 2=#a9b665
palette = 3=#d8a657
palette = 4=#7daea3
palette = 5=#d3869b
palette = 6=#89b482
palette = 7=#d5c4a1

# Bright ANSI (8–15) — classic Gruvbox brights. Bold maps here.
palette = 8=#928374
palette = 9=#fb4934
palette = 10=#b8bb26
palette = 11=#fabd2f
palette = 12=#83a598
palette = 13=#d3869b
palette = 14=#8ec07c
palette = 15=#fbf1c7

bold-color = bright
window-theme = dark
macos-titlebar-style = tabs
